# General configuration
HF_HOME="$WORK/.cache/huggingface"
DATA_PATH="/path/to/fundus/datasets"
OUTPUT_DIR="results/evals"

# HF_HUB_CACHE is derived as "$HF_HOME/hub" by jobs/common_paths.sh.
# Adapter evaluations and analyses default to siblings of OUTPUT_DIR:
# results/evals_sft, results/evals_grpo, results/analysis, results/analysis_ft.
# Optional overrides (all-task variants also accept SFT_ALL_* / GRPO_ALL_*):
# SFT_EVAL_DIR="/path/to/evals_sft"
# GRPO_EVAL_DIR="/path/to/evals_grpo"
# ANALYSIS_DIR="/path/to/analysis"
# FT_ANALYSIS_DIR="/path/to/analysis_ft"
# SFT_ANALYSIS_DIR="/path/to/analysis_sft"
# GRPO_ANALYSIS_DIR="/path/to/analysis_grpo"

# Models and external repositories directories
CHECKPOINTS_DIR="results/checkpoints"
EXT_REPOS_DIR="ext_repos"

# Slurm / HPC specific (Optional to source in shell scripts)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
